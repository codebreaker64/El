# ── Agora ───────────────────────────────────────────────────────────────────
# Your Agora App ID (from Console project list)
AGORA_APP_ID=43255fc9405c4e4dbeae512d2700d917

# The "agora token=..." auth token from your curl header (just the 007eJx... part)
AGORA_TOKEN=007eJxTYJibP+HPnsjLJl08H75v5q9wY3...

# RTC token for the agent to join the channel (generate in Console > Token Builder)
AGORA_RTC_TOKEN=007eJxTYJibP+HPnsjLJl08H75v5q9wY3...

# Pipeline ID from Agora Studio (your saved agent config)
AGORA_PIPELINE_ID=1ff64a4474604469874405f1d681160e

# ── ngrok ───────────────────────────────────────────────────────────────────
# The public HTTPS URL ngrok gives you each session (no trailing slash)
NGROK_URL=https://xxxx.ngrok-free.app

# ── Shopify ─────────────────────────────────────────────────────────────────
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=shpat_xxxxxxxxxxxx
