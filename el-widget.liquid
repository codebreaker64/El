<!--  STYLES                                                -->
<!-- ══════════════════════════════════════════════════════ -->
<style>
  #el-assistant-root {
    position: fixed; bottom: 28px; right: 28px; z-index: 999999;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    display: flex; flex-direction: column; align-items: flex-end; gap: 14px;
  }

  /* Chat container */
  #el-chat-container {
    width: 360px; height: 520px;
    background: #fff; border-radius: 22px;
    box-shadow: 0 20px 60px rgba(0,0,0,.22), 0 4px 16px rgba(0,0,0,.1);
    display: none; flex-direction: column; overflow: hidden;
    border: 1px solid rgba(0,0,0,.08);
    opacity: 0; transform: translateY(16px) scale(.97);
    transition: opacity .25s ease, transform .25s ease;
  }
  #el-chat-container.el-open { opacity: 1; transform: translateY(0) scale(1); }

  /* Header */
  #el-chat-header {
    padding: 14px 18px; background: #111; color: #fff;
    display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;
  }
  #el-status-dot {
    width: 9px; height: 9px; border-radius: 50%; background: #ff3b30;
    display: inline-block; animation: el-pulse 1.6s ease-in-out infinite;
  }
  #el-status-dot.el-connected { background: #34c759; }

  /* Messages area */
  #el-chat-messages {
    flex: 1; padding: 14px 14px 8px; overflow-y: auto;
    display: flex; flex-direction: column; gap: 8px;
    background: #f5f5f7; scroll-behavior: smooth;
  }
  #el-chat-messages::-webkit-scrollbar { width: 5px; }
  #el-chat-messages::-webkit-scrollbar-track { background: transparent; }
  #el-chat-messages::-webkit-scrollbar-thumb { background: #d0d0d0; border-radius: 3px; }

  /* Message rows – hold sender label + bubble */
  .el-msg-row {
    display: flex; flex-direction: column; gap: 2px;
  }
  .el-row-ai  { align-items: flex-start; }
  .el-row-user{ align-items: flex-end;   }

  /* Sender label */
  .el-sender-lbl {
    font-size: 11px; font-weight: 700; color: #999;
    padding: 0 4px;
  }

  /* Bubbles */
  .el-msg-bubble {
    padding: 10px 14px; border-radius: 18px;
    max-width: 82%; font-size: 14px; line-height: 1.45;
    word-wrap: break-word; animation: el-pop .2s ease;
  }
  .el-msg-ai   { background: #e8e8ed; color: #1c1c1e; border-bottom-left-radius: 6px; }
  .el-msg-user { background: #007aff; color: #fff;     border-bottom-right-radius: 6px; }

  /* Product card (legacy standalone – kept for safety) */
  .el-product-card {
    align-self: flex-start; background: #fff;
    border: 1px solid #e0e0e0; border-radius: 14px; overflow: hidden;
    width: 180px; box-shadow: 0 2px 10px rgba(0,0,0,.09); animation: el-pop .25s ease;
  }
  .el-product-card img { width: 100%; height: 130px; object-fit: cover; display: block; }
  .el-product-card-info { padding: 10px 12px; }
  .el-product-card-title { font-weight: 600; font-size: 12px; color: #111; margin-bottom: 3px; line-height: 1.3; }
  .el-product-card-price { font-size: 12px; color: #555; }

  /* Product embed — lives INSIDE El's bubble */
  .el-product-embed {
    margin-top: 10px; border-radius: 12px; overflow: hidden;
    background: #fff; border: 1px solid rgba(0,0,0,.1);
    animation: el-pop .25s ease;
  }
  .el-product-embed img {
    width: 100%; max-height: 180px; object-fit: cover; display: block;
  }
  .el-product-embed-info {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 8px 10px; gap: 8px;
  }
  .el-product-embed-title { font-weight: 600; font-size: 12px; color: #111; line-height: 1.3; }
  .el-product-embed-price { font-size: 12px; color: #555; white-space: nowrap; }

  /* Checkout button */
  .el-checkout-wrap { align-self: stretch; padding: 4px 0; animation: el-pop .25s ease; }
  .el-checkout-btn {
    display: block; background: #111; color: #fff; text-decoration: none;
    padding: 12px 20px; border-radius: 50px; font-size: 14px; font-weight: 600;
    text-align: center; width: 100%; box-sizing: border-box;
    transition: background .18s, transform .1s;
  }
  .el-checkout-btn:hover  { background: #333; transform: translateY(-1px); }
  .el-checkout-btn:active { transform: translateY(0); }

  /* Mic strip */
  #el-mic-strip {
    display: none; align-items: center; justify-content: center; gap: 10px;
    padding: 10px 18px; background: #f5f5f7; border-top: 1px solid #e5e5ea; flex-shrink: 0;
  }
  #el-mic-strip.el-listening { display: flex; }
  #el-bars { display: flex; gap: 3px; align-items: center; height: 20px; }
  #el-bars span {
    display: block; width: 3px; background: #007aff; border-radius: 2px;
    animation: el-bar .8s ease-in-out infinite alternate;
  }
  #el-bars span:nth-child(1){ height:6px;  animation-delay:.0s; }
  #el-bars span:nth-child(2){ height:14px; animation-delay:.1s; }
  #el-bars span:nth-child(3){ height:20px; animation-delay:.2s; }
  #el-bars span:nth-child(4){ height:14px; animation-delay:.3s; }
  #el-bars span:nth-child(5){ height:6px;  animation-delay:.4s; }
  #el-mic-label { font-size: 12px; color: #555; }

  /* Toggle button */
  #el-button {
    width: 66px; height: 66px; border-radius: 50%; border: none; background: #111;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 24px rgba(0,0,0,.28); outline: none;
    transition: all .3s cubic-bezier(.175,.885,.32,1.275);
  }
  #el-button:hover  { transform: scale(1.08); box-shadow: 0 12px 30px rgba(0,0,0,.32); }
  #el-button:active { transform: scale(.95); }
  #el-button.el-active       { background: #ff3b30; }
  #el-button.el-active:hover { background: #e0342b; }

  /* Animations */
  @keyframes el-pulse {
    0%,100% { opacity:1; transform:scale(1);   }
    50%      { opacity:.5; transform:scale(.8); }
  }
  @keyframes el-pop {
    from { opacity:0; transform:scale(.92) translateY(4px); }
    to   { opacity:1; transform:scale(1)   translateY(0);   }
  }
  @keyframes el-bar {
    from { transform:scaleY(.4); }
    to   { transform:scaleY(1);  }
  }
</style>

