<!-- ============================================================
  El Voice Assistant Widget  v3
  Paste into Shopify theme.liquid before </body>
  ============================================================ -->

<div id="el-assistant-root">

  <!-- Chat window -->
  <div id="el-chat-container">
    <div id="el-chat-header">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.5"/>
          <path d="M8 12.5C8 12.5 9.5 15 12 15C14.5 15 16 12.5 16 12.5" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="9.5" cy="10" r="1" fill="white"/>
          <circle cx="14.5" cy="10" r="1" fill="white"/>
        </svg>
        <span style="font-weight:700;font-size:15px;">El – Shopping Assistant</span>
      </div>
      <div style="display:flex;align-items:center;gap:8px;">
        <span id="el-status-text" style="font-size:11px;opacity:0.65;">Connecting…</span>
        <span id="el-status-dot"></span>
      </div>
    </div>

    <div id="el-chat-messages">
      <div class="el-msg-row el-row-ai">
        <span class="el-sender-lbl">El</span>
        <div class="el-msg-bubble el-msg-ai">Waking up El…</div>
      </div>
    </div>

    <div id="el-mic-strip">
      <div id="el-bars">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <span id="el-mic-label">Listening…</span>
    </div>
  </div>

  <!-- Toggle button -->
  <button id="el-button" aria-label="Talk to El">
    <svg id="el-mic-icon" width="28" height="28" viewBox="0 0 24 24" fill="none">
      <rect x="9" y="2" width="6" height="11" rx="3" fill="white"/>
      <path d="M5 10C5 14.418 8.134 18 12 18C15.866 18 19 14.418 19 10" stroke="white" stroke-width="2" stroke-linecap="round"/>
      <line x1="12" y1="18" x2="12" y2="22" stroke="white" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <svg id="el-stop-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" style="display:none;">
      <rect x="5" y="5" width="14" height="14" rx="3" fill="white"/>
    </svg>
  </button>
</div>

